NODE_ENV=development
PORT=3003

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/turnup

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=turnup-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@pickngo.com

# Pickngo core service
PICKNGO_API_URL=http://localhost:3000
PICKNGO_API_KEY=

# Reservation TTL (seconds)
RESERVATION_TTL=172800

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PUBLIC=60
RATE_LIMIT_MAX_AUTH=600
RATE_LIMIT_MAX_WRITE=30
